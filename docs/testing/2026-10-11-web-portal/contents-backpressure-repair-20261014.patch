diff --git a/service/packages/mcp/test/portal/contents-backpressure.test.ts b/service/packages/mcp/test/portal/contents-backpressure.test.ts
new file mode 100644
--- /dev/null
+++ b/service/packages/mcp/test/portal/contents-backpressure.test.ts
@@ -0,0 +1,38 @@
+import { expect, it } from 'vitest';
+import { PortalCoordinator } from '../../src/portal/coordinator.js';
+import type { PortalRun } from '@sfp/ir';
+
+const contents = PortalCoordinator.prototype as unknown as {
+  contents: (run: PortalRun) => Promise<Array<{ path: string; content: string; encoding: string }>>;
+};
+const run = (count: number) => ({
+  files: Array.from({ length: count }, (_, index) => ({
+    path: `file-${index}.txt`, contentHash: 'sha256:' + index.toString(16).padStart(64, '0'),
+  })),
+}) as unknown as PortalRun;
+
+it('reads actual-sized 75 and larger 100 file candidates below the 64 pending ACL cap in stable order', async () => {
+  for (const count of [75, 100]) {
+    let active = 0, maximum = 0;
+    const store = { get: async (_kind: string, key: string) => {
+      active++; maximum = Math.max(maximum, active);
+      if (active > 64) throw Error('WINDOWS_BOUNDARY_QUEUE_FULL');
+      await new Promise<void>(resolve => setTimeout(resolve, 1)); active--;
+      return { hash: 'sha256:' + key, content: key, encoding: 'utf8' as const };
+    } };
+    const result = await contents.contents.call({ store }, run(count));
+    expect(result.map(file => file.path)).toEqual(run(count).files.map(file => file.path));
+    expect(result).toHaveLength(count); expect(maximum).toBeLessThanOrEqual(8); expect(active).toBe(0);
+  }
+});
+it('drains the failing batch before propagating the original failure and never starts later reads', async () => {
+  const failure = Error('STATE_ACL_COMMAND_FAILED'); let active = 0, started = 0;
+  const store = { get: async (_kind: string, key: string) => {
+    active++; started++;
+    if (Number.parseInt(key, 16) === 0) { active--; throw failure; }
+    await new Promise<void>(resolve => setTimeout(resolve, 5)); active--;
+    return { hash: 'sha256:' + key, content: key, encoding: 'utf8' as const };
+  } };
+  await expect(contents.contents.call({ store }, run(100))).rejects.toBe(failure);
+  expect(active).toBe(0); expect(started).toBe(8);
+});
