{
  "$schema": "./node_modules/knip/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "project": ["*.{ts,js}"],
      "entry": ["scripts/contracts-lib.mjs"]
    },
    "packages/shared": {
      "project": ["src/**/*.ts"]
    },
    "packages/ir": {
      "project": ["src/**/*.ts"]
    },
    "packages/mcp": {
      "project": ["src/**/*.ts"]
    },
    "packages/plugin": {
      "project": ["protocol/**/*.ts", "src/**/*.ts", "ui/**/*.{ts,vue,css}"]
    },
    "packages/cli": {
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["ignore", "oxc-parser", "@sfp/mcp"]
    },
    "packages/portal": {
      "entry": [
        "web/app.js",
        "web/figma-settings.js",
        "web/figma-auth-consent.js",
        "web/tests/*.mjs"
      ],
      "project": ["src/**/*.ts", "web/**/*.js", "web/**/*.mjs"]
    }
  }
}
