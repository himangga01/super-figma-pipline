{
  "$schema": "./node_modules/knip/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": ["icacls.exe"],
  "workspaces": {
    ".": {
      "project": ["*.{ts,js}"]
    },
    "packages/shared": {
      "project": ["src/**/*.ts"]
    },
    "packages/ir": {
      "project": ["src/**/*.ts"]
    },
    "packages/mcp": {
      "project": ["src/**/*.ts"]
    },
    "packages/plugin": {
      "project": ["protocol/**/*.ts", "src/**/*.ts", "ui/**/*.{ts,vue,css}"]
    },
    "packages/cli": {
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["ignore", "oxc-parser", "@sfp/mcp"]
    }
  }
}
